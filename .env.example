# PRIVATE SERVER ONLY. Copy to .env and add your key locally.
# Never embed these values in index.html or deploy .env to GitHub Pages.
MOONSHOT_API_KEY=
# Server deliberately pins kimi-k3 and api.moonshot.ai; no user-supplied upstream URL.

# Default loopback binding is for local use only.
HOST=127.0.0.1
PORT=8787
# Optional comma-separated extra frontend origins. The deployed Vercel site is
# allowed automatically because it calls its own function on the same origin.
ALLOWED_ORIGIN=https://stanleycheng.github.io
# Remote hosting requires a separate random token of at least 32 characters.
# It must NEVER be your Kimi key. Enter this app code in the private frontend connection.
TRAILCRAFT_ACCESS_TOKEN=
